# ===========================================
# ClinicaWeb - Environment Configuration
# ===========================================

# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MySQL Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=clinica_root_pass
DB_NAME=clinicaweb

# JWT Authentication
JWT_SECRET=change_this_to_a_strong_random_secret_min_32_chars_clinicaweb_2026
JWT_EXPIRES_IN=8h

# Frontend (Vite) - optional override if API runs on another host/port
VITE_API_URL=http://localhost:5000/api
